# Copy to backend/.env (or run `make init`). Never commit backend/.env.

# LLM gateway (OpenAI-compatible) — required for evaluations, the copilot and embeddings
LLM_BASE_URL=https://your-gateway.example.com
LLM_API_KEY=sk-...
MODEL_AGENT=azure/deepSeek-V4-Flash
MODEL_UTIL=gpt-4o-mini
MODEL_JUDGE=gpt-5-nano
EMBED_MODEL=text-embedding-3-large
EMBED_DIMS=1024

# Storage (paths are relative to backend/)
DATA_DIR=data
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=change-me

# Sessions — `make init` fills this with a random value
SESSION_SECRET=

# Code sandbox (Colima users: unix:///Users/<you>/.colima/default/docker.sock)
DOCKER_HOST=unix:///var/run/docker.sock

# Demo features: seed data, demo accounts on /login, admin clock fast-forward
DEMO_MODE=true

# Optional integrations — features degrade gracefully when unset
RAPIDAPI_KEY=
MCA_API_KEY=
MCA_API_URL=https://api.karza.in/v3/company-master
